<div class="max-w-2xl">
  <h1 class="text-2xl font-bold mb-1">Settings</h1>
  <p class="text-gray-600 mb-6">Connect this tracker to Claude (or anything else that speaks MCP).</p>

  <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
    <h2 class="font-semibold mb-1">API token</h2>
    <p class="text-sm text-gray-500 mb-4">
      Identifies you to the MCP endpoint, so you see your own tickets<%= " and your queue" if admin? %>.
    </p>

    <% if @new_token %>
      <div class="rounded-md bg-green-50 border border-green-200 p-3 mb-4">
        <p class="text-xs font-medium text-green-800 mb-1">Copy this now — it won't be shown again.</p>
        <code class="block text-sm font-mono break-all text-green-900"><%= @new_token %></code>
      </div>
    <% elsif current_user.api_token? %>
      <p class="text-sm text-gray-700 mb-4">A token is active. Generating a new one replaces it.</p>
    <% else %>
      <p class="text-sm text-gray-700 mb-4">You don't have a token yet.</p>
    <% end %>

    <div class="flex items-center gap-3">
      <%= button_to (current_user.api_token? ? "Generate a new token" : "Generate token"), api_token_settings_path,
            method: :post, class: "bg-red-600 text-white px-3 py-1.5 rounded-md text-sm font-medium hover:bg-red-700 cursor-pointer" %>
      <% if current_user.api_token? %>
        <%= button_to "Revoke", api_token_settings_path, method: :delete,
              form: { data: { turbo_confirm: "Revoke your API token? Anything using it will stop working." } },
              class: "text-sm text-gray-500 hover:text-gray-900 underline bg-transparent border-0 p-0 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold mb-1">Connect it to Claude Code</h2>
    <p class="text-sm text-gray-500 mb-3">Run this with your token in place of <code>YOUR_TOKEN</code>:</p>

    <pre class="bg-gray-900 text-gray-100 rounded-md p-3 text-xs overflow-x-auto"><code>claude mcp add --transport http tickets <%= mcp_url %> \
  --header "Authorization: Bearer YOUR_TOKEN"</code></pre>

    <p class="text-sm text-gray-500 mt-4 mb-2">Then ask it things like:</p>
    <ul class="text-sm text-gray-600 list-disc list-inside space-y-1">
      <% if admin? %>
        <li>"What's on my plate?"</li>
        <li>"Mark ticket 12 done and tell them it shipped this morning"</li>
      <% end %>
      <li>"File a ticket: the signup page 500s on mobile"</li>
      <li>"What have I filed, and where is it at?"</li>
    </ul>
  </div>
</div>
