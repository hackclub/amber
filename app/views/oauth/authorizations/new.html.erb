<div class="max-w-md mx-auto mt-12">
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h1 class="text-xl font-bold mb-1"><%= @client.name %> wants access</h1>
    <p class="text-sm text-gray-500 mb-5">
      Signed in as <%= current_user.name.presence || current_user.email %>.
    </p>

    <ul class="text-sm text-gray-700 space-y-2 mb-5">
      <li class="flex gap-2"><span aria-hidden="true">•</span> File tickets as you</li>
      <li class="flex gap-2"><span aria-hidden="true">•</span> Read the tickets you've filed</li>
      <% if admin? %>
        <li class="flex gap-2"><span aria-hidden="true">•</span> Read and triage everyone's tickets, and manage services and topics</li>
      <% end %>
    </ul>

    <div class="bg-gray-50 border border-gray-200 rounded-md p-3 mb-5">
      <p class="text-xs text-gray-500">It will send you back to</p>
      <p class="text-xs font-mono text-gray-700 break-all"><%= params[:redirect_uri] %></p>
    </div>

    <%= form_with url: oauth_authorize_path, method: :post, data: { turbo: false }, class: "flex items-center gap-3" do %>
      <% @authorization.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>

      <%= submit_tag "Approve", name: "commit",
            class: "bg-red-600 text-white px-4 py-2 rounded-md font-medium hover:bg-red-700 cursor-pointer" %>
      <%= submit_tag "Deny", name: "commit",
            class: "text-sm text-gray-500 hover:text-gray-900 underline bg-transparent border-0 p-0 cursor-pointer" %>
    <% end %>
  </div>

  <p class="text-xs text-gray-400 mt-3 text-center">
    You can revoke this later from <%= link_to "Settings", settings_path, class: "underline" %>.
  </p>
</div>
