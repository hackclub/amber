<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tickets" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tickets">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Tickets", root_path, class: "font-bold text-lg text-red-600" %>
          <% if current_user %>
            <%= link_to "New ticket", new_ticket_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% if admin? %>
              <div class="flex items-center gap-4 border-2 border-dashed border-orange-400 bg-orange-50 rounded-lg px-3 py-1">
                <%= link_to "Services", admin_services_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
                <%= link_to "Topics", admin_topics_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
                <%= link_to "People", admin_users_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if current_user %>
          <div class="flex items-center gap-3">
            <%= avatar_tag(current_user, css_class: "size-8 rounded-full") %>
            <span class="text-sm text-gray-700"><%= current_user.name.presence || current_user.email %></span>
            <%= button_to "Sign out", "/logout", method: :delete, class: "text-sm text-gray-500 hover:text-gray-900 underline bg-transparent border-0 p-0 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <% if notice %>
        <div class="mb-4 rounded-md bg-green-50 text-green-800 px-4 py-3 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded-md bg-red-50 text-red-800 px-4 py-3 text-sm"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
