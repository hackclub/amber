<div class="max-w-2xl">
  <div class="flex items-center gap-2 mb-1 flex-wrap">
    <h1 class="text-2xl font-bold"><%= @ticket.title %></h1>
    <span class="text-xs px-2 py-0.5 rounded-full <%= priority_badge_classes(@ticket.priority) %>"><%= @ticket.priority.humanize %></span>
    <span class="text-xs px-2 py-0.5 rounded-full <%= status_badge_classes(@ticket.status) %>"><%= @ticket.status.humanize %></span>
  </div>

  <p class="text-sm text-gray-500 mb-6">
    <%= @ticket.service.name %> &rsaquo; <%= @ticket.topic.name %> &middot;
    filed by
    <% if admin? %>
      <%= link_to (@ticket.user.name.presence || @ticket.user.email), admin_user_path(@ticket.user), class: "underline" %>
      <% if (dm_url = slack_dm_url(@ticket.user)) %>
        &middot; <%= link_to "Message on Slack", dm_url, class: "text-blue-600 hover:underline", target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
    <% else %>
      <%= @ticket.user.name.presence || @ticket.user.email %>
    <% end %>
    &middot; <%= time_ago_in_words(@ticket.created_at) %> ago
  </p>

  <% if (safe_url = safe_http_url(@ticket.url)) %>
    <p class="mb-4"><%= link_to safe_url, safe_url, class: "text-blue-600 hover:underline break-all", rel: "noopener noreferrer" %></p>
  <% end %>

  <div class="prose prose-sm max-w-none bg-white border border-gray-200 rounded-lg p-4 mb-6">
    <%= markdown(@ticket.message) %>
  </div>

  <% if @ticket.status_note.present? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <p class="text-xs font-medium text-blue-800 mb-1">Latest update</p>
      <div class="prose prose-sm max-w-none text-blue-900"><%= markdown(@ticket.status_note) %></div>
    </div>
  <% end %>

  <% if admin? %>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
      <h2 class="text-sm font-semibold text-amber-900">Internal notes</h2>
      <p class="text-xs text-amber-700 mb-3">Only admins see these. Nothing here is emailed or DM'd to <%= @ticket.user.name.presence || "them" %>.</p>

      <% if @ticket.notes.any? %>
        <ul class="space-y-2 mb-3">
          <% @ticket.notes.oldest_first.each do |note| %>
            <li class="bg-white border border-amber-200 rounded-md px-3 py-2">
              <div class="flex items-start justify-between gap-3">
                <div class="prose prose-sm max-w-none text-gray-800"><%= markdown(note.body) %></div>
                <%= button_to "×", ticket_note_path(@ticket, note), method: :delete,
                      class: "shrink-0 text-amber-700 hover:text-amber-900 bg-transparent border-0 p-0 cursor-pointer leading-none text-lg",
                      form: { data: { turbo_confirm: "Delete this note?" } } %>
              </div>
              <p class="text-xs text-amber-700 mt-1">
                <%= note.author.name.presence || note.author.email %> · <%= time_ago_in_words(note.created_at) %> ago
              </p>
            </li>
          <% end %>
        </ul>
      <% end %>

      <%= form_with url: ticket_notes_path(@ticket), scope: :ticket_note, class: "flex items-start gap-2" do |f| %>
        <%= f.text_area :body, rows: 2, placeholder: "Waiting on a reply from…", class: input_classes("text-sm") %>
        <%= f.submit "Add note", class: "shrink-0 text-sm bg-amber-600 text-white px-3 py-2 rounded-md font-medium hover:bg-amber-700 cursor-pointer" %>
      <% end %>
    </div>

    <%= form_with model: @ticket, url: ticket_path(@ticket), method: :patch, class: "bg-white border border-gray-200 rounded-lg p-4 space-y-3" do |f| %>
      <div class="flex items-center gap-2">
        <%= f.label :status, "Update status", class: "text-sm font-medium text-gray-700" %>
        <%= f.select :status, Ticket.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: input_classes %>
      </div>

      <div>
        <%= f.label :status_note, "Note for #{@ticket.user.name.presence || 'them'} (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :status_note, rows: 3, value: nil, placeholder: "Shipped in this morning's deploy.", class: input_classes("text-sm") %>
        <p class="text-xs text-gray-400 mt-1">Sent with the status change, by email and Slack DM.</p>
      </div>

      <%= f.submit "Update", class: "bg-red-600 text-white px-3 py-1.5 rounded-md text-sm font-medium hover:bg-red-700 cursor-pointer" %>
    <% end %>
  <% end %>
</div>
