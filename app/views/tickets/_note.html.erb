<li id="<%= dom_id(note) %>" class="bg-white border border-amber-200 rounded-md px-3 py-2">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1 prose prose-sm max-w-none break-words [overflow-wrap:anywhere] prose-pre:overflow-x-auto text-gray-800"><%= markdown(note.body) %></div>
    <%= button_to "×", ticket_note_path(note.ticket, note), method: :delete,
          class: "shrink-0 text-amber-700 hover:text-amber-900 bg-transparent border-0 p-0 cursor-pointer leading-none text-lg",
          form: { data: { turbo_confirm: "Delete this note?" } } %>
  </div>
  <p class="text-xs text-amber-700 mt-1">
    <%= note.author.name.presence || note.author.email %> · <%= time_ago_in_words(note.created_at) %> ago
  </p>
</li>
