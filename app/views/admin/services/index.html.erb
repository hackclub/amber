<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Services</h1>
  <%= link_to "New service", new_admin_service_path, class: "bg-red-600 text-white px-4 py-2 rounded-md font-medium hover:bg-red-700" %>
</div>

<div class="divide-y divide-gray-200 bg-white rounded-lg border border-gray-200">
  <% @services.each do |service| %>
    <div class="p-4 flex items-center justify-between gap-4">
      <div>
        <p class="font-medium text-gray-900">
          <%= service.name %>
          <% unless service.active? %><span class="text-xs text-gray-400">(inactive)</span><% end %>
        </p>
        <p class="text-sm text-gray-500"><%= pluralize(service.topics.size, "topic") %></p>
      </div>
      <div class="flex items-center gap-3 text-sm">
        <%= link_to "Topics", admin_topics_path(service_id: service.id), class: "text-gray-600 hover:underline" %>
        <%= link_to "Edit", edit_admin_service_path(service), class: "text-gray-600 hover:underline" %>
        <%= button_to "Delete", admin_service_path(service), method: :delete, class: "text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer",
              form: { data: { turbo_confirm: "Delete #{service.name}?" } } %>
      </div>
    </div>
  <% end %>
</div>
