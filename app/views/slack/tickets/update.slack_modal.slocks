title "Update ticket"
submit "Update"
close "Cancel"
callback "update_ticket"
private_metadata "#{ticket.id}:#{status}"

section "*#{ticket.title}*\nSetting status to *#{status.humanize}*", markdown: true

input "Note (optional)",
      plain_text_input("note", multiline: true, placeholder: "Shipped in this morning's deploy."),
      block_id: "note",
      optional: true,
      hint: "#{ticket.user.name.presence || 'They'} will get this by DM and email."
