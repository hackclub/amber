# Hack Club Auth (https://auth.hackclub.com/developer/apps)
# Leave these blank in development to use the built-in :developer sign-in form instead.
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=
HACKCLUB_AUTH_REDIRECT_URI=https://amber.hackclub.com/auth/hackclub/callback

# Comma-separated list of emails who get the admin dashboard + notification emails
ADMIN_EMAILS=amber@hackclub.com

# Used to build absolute URLs in emails, and for host authorization in production
APP_HOST=amber.hackclub.com

# Outgoing mail (production only — development uses letter_opener)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USER_NAME=
SMTP_PASSWORD=
MAILER_FROM=tickets@hackclub.com
